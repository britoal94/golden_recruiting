{
  "name": "golden-recruiting",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --harmony-temporal ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --harmony-temporal ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --harmony-temporal ./node_modules/astro/bin/astro.mjs preview",
    "check": "node --harmony-temporal ./node_modules/astro/bin/astro.mjs check",
    "astro": "node --harmony-temporal ./node_modules/astro/bin/astro.mjs",
    "assets": "node scripts/gen-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "resend": "^6.28.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
