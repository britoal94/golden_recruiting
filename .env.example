# Canonical URL (no trailing slash). Used for canonical/OG tags and the sitemap.
SITE_URL=https://goldenrecruiting.com

# Analytics — the site loads each tracker only when its key is set.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_GA_ID=

# Contact form (Resend). CONTACT_FROM_EMAIL must be on a verified Resend domain;
# onboarding@resend.dev works for testing but can only deliver to your own account email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Golden Recruiting <hello@goldenrecruiting.com>"
