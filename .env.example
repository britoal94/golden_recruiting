# Canonical URL (no trailing slash). Used for canonical/OG tags and the sitemap.
SITE_URL=https://goldenrecruiting.com

# Analytics — the site loads each tracker only when its key is set.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_GA_ID=

# Contact form (Resend). On Vercel, RESEND_API_KEY and RESEND_EMAIL_DOMAIN are
# injected by the Resend Marketplace integration (sending domain: mail.goldenrecruiting.com).
# Locally: `vercel env pull .env.local`.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=mail.goldenrecruiting.com
CONTACT_TO_EMAIL=
# Optional override; defaults to "Golden Recruiting <contact@$RESEND_EMAIL_DOMAIN>".
CONTACT_FROM_EMAIL=
