---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import VercelAnalytics from '@vercel/analytics/astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...Astro.props} />
    <Font cssVariable="--font-newsreader" preload={[{ weight: '500', style: 'normal' }]} />
    <Font cssVariable="--font-plex" preload={[{ weight: '400', style: 'normal' }]} />
    <Analytics />
    <VercelAnalytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-[3px] focus:bg-gold focus:px-4 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
