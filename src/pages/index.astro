---
import SitePage from "../layouts/SitePage.astro";
import BrandPhoto from "../components/BrandPhoto.astro";
import conversation from "../assets/brand/advisor-conversation.webp";
import connection from "../assets/brand/connection.webp";
import partnership from "../assets/brand/partnership.webp";
import team from "../assets/brand/team-discussion.webp";
---

<SitePage
  title={"Golden Recruiting — Founder-Led Search Firm, Charlotte NC"}
  description={
    "Founder-led recruiting firm in Charlotte, NC. We find and vet the hard-to-hire builders, advisors, and leaders your team needs, nationwide."
  }
  heading={"Founder-Led Recruiting"}
  intro={
    "Build your team with the builders, analysts, advisors, and leaders who aren't applying anywhere."
  }
>
  <p slot="hook" class="mt-6 text-2xl">
    The right hire changes everything.
    <br />
    Let's go find them.
  </p>
  <div slot="hero">
    <a class="btn mt-6" href="/services">
      Our Services
    </a>
    <BrandPhoto
      src={conversation}
      alt="Two professionals in a one-to-one conversation in a bright office"
    />
  </div>
  <section aria-labelledby="who" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <h2 id="who" class="text-3xl leading-snug">
        Who we are
      </h2>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        We're a small, founder-led firm that believes hiring is one of the most
        personal decisions a company makes. We get to know your team before we
        make a single call, and we only introduce people we'd hire ourselves.
      </p>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        You know where your company is headed. We find the people who will help
        you get there.
      </p>
      <a class="btn mt-6" href="/team">
        Learn more
      </a>
      <BrandPhoto
        src={connection}
        alt="Professionals sharing a conversation around a table"
      />
    </div>
  </section>
  <section aria-labelledby="talk" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <h2 id="talk" class="text-3xl leading-snug">
        Talk with Bri.
      </h2>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        Have a role that's been open too long, or one you can't afford to get
        wrong? Start with a conversation with our founder.
      </p>
      <a class="btn mt-6" href="/contact">
        Get in touch
      </a>
    </div>
  </section>
  <section
    aria-labelledby="services"
    class="border-b border-line py-14 sm:py-20"
  >
    <div class="wrap">
      <h2 id="services" class="text-3xl leading-snug">
        Our Services
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="rounded-lg border border-line bg-bg-raised p-6">
          <h3 class="text-xl">RPO | Recruitment Process Outsourcing</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            We join your team as your recruiting function. We learn your
            company, speak in your voice, and run sourcing, screening, and
            pipeline for every role you're hiring.
          </p>
        </article>
        <article class="rounded-lg border border-line bg-bg-raised p-6">
          <h3 class="text-xl">Container Search</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            A focused search led by Bri, with part of the fee paid upfront and
            the rest when you hire. You get retained-level attention without the
            full retainer.
          </p>
        </article>
        <article class="rounded-lg border border-line bg-bg-raised p-6">
          <h3 class="text-xl">Contingent Search</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            Tell us what you need. If you hire someone we introduce, you pay a
            fee. If you don't, you owe nothing.
          </p>
        </article>
      </div>
      <a class="btn mt-6" href="/services">
        Learn more
      </a>
    </div>
  </section>
  <section aria-labelledby="why" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <h2 id="why" class="text-3xl leading-snug">
        Why Golden Recruiting
      </h2>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        No two teams hire the same way, so we don't run the same search twice.
        You get a founder with more than a decade in talent acquisition, working
        your search herself.
      </p>
      <ul class="mt-6 list-disc space-y-3 pl-5 text-ink-dim">
        <li>
          You work with the person making the calls, never a rotating account
          team.
        </li>
        <li>
          You see a short list of people we've already interviewed, not a stack
          of resumes.
        </li>
        <li>
          You hear the truth about the market, the salary, and the role, early
          enough to act on it.
        </li>
      </ul>
      <a class="btn mt-6" href="/mission">
        Learn more
      </a>
      <BrandPhoto
        src={partnership}
        alt="Two professionals walking together through a sunlit hallway"
      />
    </div>
  </section>
  <section
    aria-labelledby="process"
    class="border-b border-line py-14 sm:py-20"
  >
    <div class="wrap">
      <h2 id="process" class="text-3xl leading-snug">
        How we work with our clients
      </h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        <li class="border-t border-line pt-5">
          <p class="text-brand" aria-hidden="true">
            01
          </p>
          <h3 class="mt-3 text-xl">Intake call</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            A real conversation about the role, the team, and what a great hire
            looks like here. Then we start the search.
          </p>
        </li>
        <li class="border-t border-line pt-5">
          <p class="text-brand" aria-hidden="true">
            02
          </p>
          <h3 class="mt-3 text-xl">Review the short list</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            We walk you through the first profiles together, so we can adjust
            quickly if the target needs to move.
          </p>
        </li>
        <li class="border-t border-line pt-5">
          <p class="text-brand" aria-hidden="true">
            03
          </p>
          <h3 class="mt-3 text-xl">Interview and hire</h3>
          <p class="mt-4 max-w-[70ch] text-ink-dim">
            You meet people we've already interviewed. We stay with you through
            offer, negotiation, and the start date.
          </p>
        </li>
      </ol>
      <BrandPhoto
        src={team}
        alt="Professionals discussing documents around an office table"
      />
    </div>
  </section>
  <section aria-labelledby="next" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <p class="mb-4 font-medium text-brand">Take the next step</p>
      <h2 id="next" class="text-3xl leading-snug">
        Let's get started.
      </h2>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        Tell us about the role. No pitch and no pressure, just a conversation
        about what you need and whether we can help.
      </p>
      <a class="btn mt-6" href="/contact">
        Book a call
      </a>
    </div>
  </section>
</SitePage>
