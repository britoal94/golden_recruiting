---
import SitePage from "../layouts/SitePage.astro";
import BrandPhoto from "../components/BrandPhoto.astro";
import candidate from "../assets/brand/candidate-conversation.webp";
---

<SitePage
  title={"Apply — Golden Recruiting"}
  description={
    "Quietly considering your next move? Start a confidential conversation with Golden Recruiting."
  }
  heading={"Looking for your next role?"}
  intro={
    "We'd love to meet you. Even if we don't have the right opening today, a good conversation now often turns into the right call later."
  }
>
  <section aria-labelledby="expect" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <h2 id="expect" class="text-3xl leading-snug">
        What to expect from us
      </h2>
      <ul class="mt-6 space-y-5 text-ink-dim">
        <li>
          A real conversation. We'll ask what you want next, not just what
          you've done.
        </li>
        <li>Honesty. If a role isn't right for you, we'll say so.</li>
        <li>
          Discretion. Your search stays private. We never share your details
          without your okay.
        </li>
        <li>No cost to you. Our clients pay our fees. Candidates never do.</li>
      </ul>
      <BrandPhoto
        src={candidate}
        alt="A one-to-one professional conversation in a bright meeting area"
      />
    </div>
  </section>
  <section aria-labelledby="people" class="border-b border-line py-14 sm:py-20">
    <div class="wrap">
      <h2 id="people" class="text-3xl leading-snug">
        Who we work with
      </h2>
      <p class="mt-4 max-w-[70ch] text-ink-dim">
        Builders, analysts, advisors, and operators, from early-career
        specialists to executives. If you're quietly considering a move, you're
        welcome to reach out in confidence.
      </p>
    </div>
  </section>
  <section
    aria-labelledby="introduce"
    class="border-b border-line py-14 sm:py-20"
  >
    <div class="wrap">
      <h2 id="introduce" class="text-3xl leading-snug">
        Send us a note and your resume or LinkedIn profile.
      </h2>
      <a
        class="btn mt-6"
        href="mailto:bri@goldenrecruiting.com?subject=Candidate%20introduction"
      >
        Introduce yourself
      </a>
    </div>
  </section>
</SitePage>
