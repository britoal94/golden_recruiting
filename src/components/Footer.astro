---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="wrap flex flex-wrap items-center justify-between gap-3 pt-9 pb-12 text-[13.5px] text-ink-dim">
  <span class="font-serif text-[15px] text-ink">{site.name}</span>
  <span>© {year} {site.legalName} · {site.location.city}, {site.location.region}</span>
</footer>
