---
import SectionHead from './SectionHead.astro';

const steps = [
  { title: 'Brief', body: 'We start with your role, team, and what "yes" actually looks like — not just a job description.' },
  { title: 'Source', body: 'Direct outreach, referrals, and targeted search — we go find candidates, not wait for applications.' },
  { title: 'Vet', body: 'Every candidate is interviewed and checked against the brief before you ever see a name.' },
  { title: 'Close', body: 'We stay in the loop through offer and negotiation, so nothing falls apart in the last mile.' },
];
---

<section id="process" class="border-b border-line py-16 sm:py-20" aria-labelledby="process-heading">
  <div class="wrap">
    <SectionHead id="process-heading" title="How a search runs">
      The same four stages, every time, so you always know where a search stands.
    </SectionHead>

    <ol class="flex flex-col">
      {steps.map((step, i) => (
        <li class="grid grid-cols-[48px_1fr] gap-4 border-t border-line py-6 first:border-t-0 sm:grid-cols-[64px_1fr] sm:gap-6">
          <span class="font-serif text-[26px] italic leading-none text-gold" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="mb-1.5 text-[17.5px] font-semibold">{step.title}</h3>
            <p class="max-w-[58ch] text-[15.5px] text-ink-dim">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
